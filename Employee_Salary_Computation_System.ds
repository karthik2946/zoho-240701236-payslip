		workflow
		{
		form
		{
			validate_duplicate_payslip as "Validate Duplicate Payslip Entry"
			{
				type =  form
				form = payslip

				record event = on add or edit

				on validate
				{
					actions 
					{
						custom deluge script
						(
											// Check if employee and month combination already exists in payslip form
										existingPayslips = payslip[employee.ID == input.employee.ID && month_1 == input.month_1 && year_1 == input.year_1];
										// If records exist, display error and cancel submission
										if(existingPayslips.count() > 0)
										{
											alert "Error: A payslip for this employee and month already exists. Please check your input.";
											cancel submit;
										}
						)
					}
				}

			}
		}

		schedule
		{
			monthly_financial_report as "Monthly Financial Report Generation"
			{
				type =  schedule
					status = inactive
				start = "2024-05-26 15:53:12"
				time zone = "Asia/Kolkata"
				on start
				{
					actions 
					{
					on load
					(
						// Fetch all payslip records for the current month and year
										// Assuming the workflow runs on the 1st of each month
										// We need to get payslips where month_1 matches current month and year_1 matches current year
										// Get current date components
										currentDate = zoho.currentdate;
										yearValue = currentDate.getYear();
										monthValue = currentDate.getMonth();
										// Define the month name based on current month number
										monthName = "";
										if(monthValue == 1)
										{
											monthName = "January";
										}
										else if(monthValue == 2)
										{
											monthName = "February";
										}
										else if(monthValue == 3)
										{
											monthName = "March";
										}
										else if(monthValue == 4)
										{
											monthName = "April";
										}
										else if(monthValue == 5)
										{
											monthName = "May";
										}
										else if(monthValue == 6)
										{
											monthName = "June";
										}
										else if(monthValue == 7)
										{
											monthName = "July";
										}
										else if(monthValue == 8)
										{
											monthName = "August";
										}
										else if(monthValue == 9)
										{
											monthName = "September";
										}
										else if(monthValue == 10)
										{
											monthName = "October";
										}
										else if(monthValue == 11)
										{
											monthName = "November";
										}
										else if(monthValue == 12)
										{
											monthName = "December";
										}
										// Fetch payslips for current month and year
										payslipRecords = payslip[month_1 == monthName && year_1 == yearValue];
										// Calculate total gross and net pay
										if(payslipRecords.count() > 0)
										{
											totalGross = 0;
											totalNetPay = 0;
											for each  payslip in payslipRecords
											{
												if(payslip.gross != null)
												{
													totalGross = totalGross + payslip.gross;
												}
												if(payslip.net_pay != null)
												{
													totalNetPay = totalNetPay + payslip.net_pay;
												}
											}
											// Prepare email message
											emailSubject = "Monthly Financial Summary - " + monthName + " " + yearValue.toString();
											emailMessage = "<p>Dear HR Team,</p>";
											emailMessage = emailMessage.concat("<p>Please find below the monthly financial summary for " + monthName + " " + yearValue.toString() + ":</p>");
											emailMessage = emailMessage.concat("<ul>");
											emailMessage = emailMessage.concat("<li>Total Payslips Processed: " + payslipRecords.count().toString() + "</li>");
											emailMessage = emailMessage.concat("<li>Total Gross Pay: " + totalGross.toString() + "</li>");
											emailMessage = emailMessage.concat("<li>Total Net Pay: " + totalNetPay.toString() + "</li>");
											emailMessage = emailMessage.concat("</ul>");
											emailMessage = emailMessage.concat("<p>Best Regards,</p>");
											emailMessage = emailMessage.concat("<p>Salary Computation System</p>");
											// Send email to HR
											sendmail
											[
												from :zoho.loginuserid
												to :"hr@company.com"
												subject :emailSubject
												message :emailMessage
												content type :HTML
											]
										}
										else
										{
											// No payslips found for the current month
											emailSubject = "Monthly Financial Summary - " + monthName + " " + yearValue.toString() + " (No Records)";
											emailMessage = "<p>Dear HR Team,</p>";
											emailMessage = emailMessage.concat("<p>No payslip records found for " + monthName + " " + yearValue.toString() + ".</p>");
											emailMessage = emailMessage.concat("<p>Best Regards,</p>");
											emailMessage = emailMessage.concat("<p>Salary Computation System</p>");
											sendmail
											[
												from :zoho.loginuserid
												to :"hr@company.com"
												subject :emailSubject
												message :emailMessage
												content type :HTML
											]
										}
					)
					}
				}
			}
		}




