 application "Employee Salary Computation System"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "America/Los_Angeles"
 	time format = "24-hr"

 	forms
	{
		form employee
		{
			displayname = "Employee"
			success message = "Employee Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			name
			(
    			type = name
				displayname = "Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			email
			(
    			type = email
				displayname = "Email"
	 			row = 1
	 			column = 1   
				width = medium
			)
			designation
			(
				type = picklist
				displayname = "Designation"
				values = {"Assistant Manager","Executive","Intern","Accountant","Manager"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			basic_pay
			(
				displayname = "Basic Pay"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			employee_code
			(
    			type = text
				displayname = "Employee Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			department
			(
				type = picklist
				displayname = "Department"
				values = {"Finance","HR","IT","Admin","Operations"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			phone_number
			(
    			type = phonenumber
				displayname = "Phone Number"
	 			row = 1
	 			column = 1   
				width = medium
			)
			address
			(
    			type = address
				displayname = "Address"
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "Latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "Longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
			)
			status
			(
				type = radiobuttons
				displayname = "Status"
				values = {"Active","Inactive"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			joining_date
			(
    			type = date
				displayname = "Joining Date"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Employee Data Entry","Pending HR Review","Approved","Pending Corrections","Rejected","IT Setup Required","Payroll Setup Required","Onboarding Complete"}
			}
		}
		form payslip
		{
			displayname = "Payslip"
			success message = "Data Added Successfully!"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			employee
			(
				type = list	
				displayname = "Employee"
				values  = employee.ID
    			displayformat = [name.first_name]
				allow new entries
				[
					displayname = "Add New"
				]
				sortorder = ascending
				height = 13px
	 			row = 1
	 			column = 1   
				width = medium
			)
			month_1
			(
				type = picklist
				displayname = "Month"
				values = {"June","October","December","May","September","March","July","January","February","April","August","November"}
				others option = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			year_1
			(
				type = number
				displayname = "Year"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			days_worked
			(
				type = number
				displayname = "Days Worked"
				maxchar = 19
	 			row = 1
	 			column = 1   
				width = medium
			)
			basic_earned
			(
				displayname = "Basic Earned"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			da
			(
				displayname = "DA"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			hra
			(
				displayname = "HRA"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			gross
			(
				displayname = "Gross"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			pf
			(
				displayname = "PF"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			net_pay
			(
				displayname = "Net Pay"
				type = USD
	 			row = 1
	 			column = 1   
				width = medium
			)
			payslip_code
			(
    			type = text
				displayname = "Payslip Code"
	 			row = 1
	 			column = 1   
				width = medium
			)
			calculation_date
			(
    			type = datetime
				displayname = "Calculation Date"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
					reset
					(
   						type = reset
   						displayname = "Reset"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
			blueprint components
			{
				stages = {"Payslip Draft Created","Calculation Pending","Calculation In Progress","Calculation Complete","Pending Approval","Approved","Processing Payment","Payment Processed","Payment Failed","Payslip Generated"}
			}
		}
	}
	reports
	{
		list payslip_Report
		{
			displayName = "Payslip Report"
			show all rows from payslip    
			(
				employee as "Employee"
				month_1 as "Month"
				year_1 as "Year"
				days_worked as "Days Worked"
				basic_earned as "Basic Earned"
				(
					display = total,average,min,max	
				)
				da as "DA"
				(
					display = total,average,min,max	
				)
				hra as "HRA"
				(
					display = total,average,min,max	
				)
				gross as "Gross"
				(
					display = total,average,min,max	
				)
				pf as "PF"
				(
					display = total,average,min,max	
				)
				net_pay as "Net Pay"
				(
					display = total,average,min,max	
				)
				payslip_code as "Payslip Code"
				calculation_date as "Calculation Date"
			)
		}
		list employee_Report
		{
			displayName = "All Employees"
			show all rows from employee    
			(
				name  as "Name"
				email as "Email"
				designation as "Designation"
				basic_pay as "Basic Pay"
				(
					display = total,average,min,max	
				)
				employee_code as "Employee Code"
				department as "Department"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				phone_number as "Phone Number"
				status as "Status"
				joining_date as "Joining Date"
			)
			conditional formatting
			(
				"New Formatting1"
				{
				condition = (designation == "Accountant")
				fields = [designation]
				format = "color:#ffffff;background-color:#765f89;"
				}
				"New Formatting2"
				{
				condition = (designation == "Assistant Manager")
				fields = [designation]
				format = "color:#000000;background-color:#1bbc9b;"
				}
				"New Formatting3"
				{
				condition = (designation == "Executive")
				fields = [designation]
				format = "color:#ffffff;background-color:#e84c3d;"
				}
				"New Formatting4"
				{
				condition = (designation == "Manager")
				fields = [designation]
				format = "color:#ffffff;background-color:#3598db;"
				}
			)
		}
		kanban employee_by_designation
		{
			displayName = "Designations"
			show all rows from employee    
			(
				name  as "Name"
				email as "Email"
				designation as "Designation"
				basic_pay as "Basic Pay"
				(
					display = total,average,min,max	
				)
				employee_code as "Employee Code"
				department as "Department"
				address  as "Address"
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				phone_number as "Phone Number"
				status as "Status"
				joining_date as "Joining Date"
			)
			options
			(
	 			display field = designation
	 		)
		}
	}
	pages
	{
		page DashBoard
		{
			displayname = "Dashboard"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='60%'\n   \t>\n\t<chart \n\telementName='Chart 1'\n\n\t\n\ttitle = 'Status by Basic Pay'\n\t\n\t\ttitleSize = '16px'\n\ttype = 'Bar'\n\txtitle = 'Status'\n\tytitle = 'Basic Pay'\n\tbgColor = 'rgb(255, 255, 255)'\n\ttheme = 'theme4'\n\tlegendPos = 'none'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'employee'\n\txfield = 'status'\n\tyfields = 'sum:basic_pay'\n\tgroupBy = 'name'\n\t\tDelugeCriteria = 'status is not null &amp;&amp; status != &quot;&quot;'\n/>\n\n</column><column\n   \t\t width='20%'\n   \t>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel 1'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginRight = '10px' \n\tmarginBottom = '0px'\n\tmarginTop = '10px'\n\n\tcolor = '#FFFFFF'\n\tbgColor = '#0CC197'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'business-percentage-39'\n\tsize = '20px'\n\tcornerRadius = '10px'\n\ticonType = 'outline'\n/>\n</pc><pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginTop = '10px'\n\tcolor = '#0CC197'\n\tsize = '24px'\n\tbold = 'true' \n\tfontFamily = 'lato, arimo, sans-serif' \n\ttype = 'Form Data'\n\n\tbgColor = 'rgba(0, 0, 0, 0)'\n\n\n\tdisplayType = 'actual'\n\tdecimalPlaces = '2'\n\tthousandsSeperator = 'LOCALE'\n\tdecimalSeperator = 'DOT'\n\tnumberScale = 'none'\n\n\n\n\n\t  value = 'thisapp.payslip.gross.sum'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\tbg